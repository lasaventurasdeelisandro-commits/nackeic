# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OTP_SECRET_SALT: Optional cryptographic salt for OTP verification.
# Automatically generated via 256-bit CSPRNG if not provided.
OTP_SECRET_SALT=""

# PostgreSQL Database (optional in local hybrid mode; required for multi-instance production)
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="nakeic_db"

# Redis Coordinator (optional in single-node mode; recommended for scaled LIVE & presence pub/sub)
REDIS_URL=""

# LiveKit WebRTC SFU (optional; enables hardware-accelerated SFU ingest/egress for massive LIVE streams)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Coturn WebRTC TURN Server (recommended for strict cellular/symmetric NAT traversal)
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Payment Gateway Webhook HMAC Secrets
BILLING_WEBHOOK_SECRET=""
WALLET_WEBHOOK_SECRET=""

