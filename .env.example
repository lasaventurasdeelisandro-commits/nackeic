# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=""

# APP_URL: The production URL where Diclik.com is hosted (HTTPS required in production).
APP_URL="https://diclik.com"
CORS_ORIGIN="https://diclik.com"

# JWT_SECRET: Mandatory secret key in production (min 64 random hex characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_64_CHAR_RANDOM_SECRET"

# RUNTIME ENVIRONMENT
NODE_ENV="production"

# POSTGRESQL CONFIGURATION (External Managed PostgreSQL in Production)
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="REPLACE_WITH_DB_PASSWORD"
# SQL_DB_NAME="diclik_production"
# PGSSLMODE="require"
# PG_POOL_MAX="20"
# DATABASE_URL="postgresql://user:password@host:5432/diclik_production?sslmode=require"

# INITIAL ADMIN BOOTSTRAP (Required on clean production databases when demo seeding is disabled)
# BOOTSTRAP_ADMIN_EMAIL="admin@diclik.com"
# BOOTSTRAP_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
# SEED_DEMO_DATA="false"

# PAYMENT PROVIDER & WEBHOOKS (Disabled until real bank/PSP keys are configured)
ENABLE_PAYMENT_WEBHOOK="false"
# PAYMENT_PROVIDER="stripe"
# PAYMENT_SECRET_KEY="REPLACE_WITH_PROVIDER_SECRET"
# PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SIGNING_SECRET"
# Simulación de recargas disponible únicamente con NODE_ENV=test.
# ALLOW_SANDBOX_PAYMENTS="false"

# ANDROID CAPACITOR PRODUCTION API URL (Never use preview URLs in release builds)
# VITE_API_BASE_URL="https://api.diclik.com/api/v1"
# CAPACITOR_SERVER_URL=""

# Number of trusted reverse proxy hops. Use 0 when directly exposed; configure only after verifying load balancer topology.
TRUST_PROXY_HOPS=0

# PASSWORD RECOVERY
# SMTP_URL="smtps://usuario:contraseña@host:465"
# PASSWORD_RESET_FROM="cuentas@diclik.com"

# HOST="127.0.0.1" # Restrict a local instance to loopback.
