<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevenir filtración de claves criptográficas y sesiones en respaldos no cifrados -->
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
        <exclude domain="database" path="nakeic_encrypted.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="encrypted_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
